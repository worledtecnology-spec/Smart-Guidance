rules_version = '2';
// قواعد أمان قاعدة بيانات بيئة التوجيه الذكي
// انسخ هذا الملف كاملاً في: Firestore Database ← Rules ← Publish
// إيميل الأدمن: drmona@gmail.com (لإضافة أدمن آخر: ['drmona@gmail.com', 'other@gmail.com'])
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['drmona@gmail.com']; }

    match /students/{code} {
      // الطالب يقرأ ملفه فقط، والأدمن يقرأ الكل
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // الأدمن وحده يضيف الطلاب ويعرض القائمة ويحذف
      allow list, create, delete: if isAdmin();
      // الحفظ: الطالب يعدّل ملفه فقط، دون تغيير اسمه أو حسابه أو نمطه، ولا يعيد المقياس بعد إتمامه
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.code == resource.data.code
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['override'])
        && (!resource.data.get('scale', {}).get('done', false) || request.resource.data.scale == resource.data.scale));
    }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
